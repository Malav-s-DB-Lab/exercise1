/* Problem 2: Find the names of all females who eat at least one pizza served by Straw Hat. (Note: The pizza need not be eaten at Straw Hat.) */

\project_{name}(
    (\select_{gender = 'female'} Person
    \join_{ Person.name = Eats.name} Eats
    )
    \join_{ eats.pizza = serves.pizza}
    (\select_{pizzerias = 'Straw Hut'}serves) 
);